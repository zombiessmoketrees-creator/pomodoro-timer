# Copy to .env on EACH machine (it is git-ignored) and adjust the paths.

# --- Obsidian ---------------------------------------------------------------
# Absolute path to the vault folder (the one that contains .obsidian).
#   macOS:   OBSIDIAN_VAULT_PATH=/Users/you/Documents/MyVault
#   Windows: OBSIDIAN_VAULT_PATH=D:/Obsidian/MyVault      (forward slashes are fine)
OBSIDIAN_VAULT_PATH=
# Optional: only scan this sub-folder for video notes (recommended for a big vault).
OBSIDIAN_VIDEO_FOLDER=

# --- Defaults for new videos ------------------------------------------------
DEFAULT_STYLE=documentary-dark
DEFAULT_FORMAT=both
# Shown in the top corner of every video. Leave empty for none.
CHANNEL_HANDLE=

# --- Storage (git-ignored). Relative paths resolve against the repo root. ----
MEDIA_DIR=media
OUTPUT_DIR=output

# --- Encoding ---------------------------------------------------------------
# auto = detect at runtime (NVENC on the NVIDIA PC, VideoToolbox on Apple Silicon,
# x264 otherwise). Force with: nvenc | videotoolbox | qsv | amf | x264
VIDEO_ENCODER=auto
# Remotion render threads, e.g. 8 or 75%. Empty = Remotion's default (half the cores).
REMOTION_CONCURRENCY=
# Only needed if Remotion cannot download/launch its own Chrome.
REMOTION_BROWSER_EXECUTABLE=

# --- Transcription (faster-whisper) ------------------------------------------
# Empty = "large-v3-turbo" on an NVIDIA GPU, "small" on CPU / Apple Silicon.
WHISPER_MODEL=
# auto | cuda | cpu
WHISPER_DEVICE=auto
# Empty = auto-detect. Set e.g. "en" to skip detection.
WHISPER_LANGUAGE=
